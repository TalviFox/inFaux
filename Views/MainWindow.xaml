                                <TextBlock Text="🔒 SHA-256 Verified" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <!-- Update & Audit Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <Button Content="Check for Updates" Click="OnCheckForUpdatesClick" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>

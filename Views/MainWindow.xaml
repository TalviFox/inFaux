                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Cooler Profile" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Scales thermal dissipation rate and cold plate resistance." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>

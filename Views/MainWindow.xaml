                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Chassis Enclosure Form Factor" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding ChassisProfileSubLabel, FallbackValue='Calibrates the zero-driver thermodynamic air cavity solver.'}" Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding ChassisProfile}" SelectedValuePath="Tag" IsEnabled="{Binding IsPhysicalMachine}" ToolTip="{Binding ChassisProfileTooltip}" Style="{StaticResource DarkComboBox}">

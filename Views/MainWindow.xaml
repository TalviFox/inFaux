                                                    <TextBlock Text="{Binding ArcticCoatModeName}" FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Switch between Midnight Glacial (Dark) and Blizzard Snow (Light)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌙 Dark" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox IsChecked="{Binding ArcticFoxLightMode}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>

<Window x:Class="InFox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="inFaux - Hardware Monitor"
        Height="760" Width="1120"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#080B11"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Modern Card Style with Hover Feedback -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#0F141C"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6B35"/>
                    <Setter Property="Background" Value="#141B26"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StaticCard" TargetType="Border">
            <Setter Property="Background" Value="#0F141C"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Monospace Value Text -->
        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, monospace"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <!-- Category Title Text -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FF8A50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>

        <!-- Custom TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF6B35"/>
                                <Setter Property="Foreground" Value="#FF6B35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-GPU Switcher Pill Button -->
        <Style x:Key="GpuPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF6B35"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#FF8A50"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Admin Notice Banner -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ADMIN NOTICE BANNER (Only visible if launched as Administrator) -->
        <Border Grid.Row="1" Visibility="{Binding AdminNoticeVisibility}" Background="#162032" BorderBrush="#38BDF8" BorderThickness="0,0,0,1" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="This app doesn't need admin! inFaux is 100% zero-driver and designed to run safely with standard user privileges." Foreground="#38BDF8" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Click="OnDismissAdminNoticeClick" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Padding="6,2" FontSize="12" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <!-- App Header -->
        <Border Grid.Row="0" Background="#0C1017" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand + Live Telemetry / API on the Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/inFaux_IHS.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="in" FontSize="20" FontWeight="Light" Foreground="#FF6B35" VerticalAlignment="Center"/>
                    <TextBlock Text="Faux" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionString}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                    </Border>

                    <!-- Telemetry Live & API Pill -->
                    <Border Background="#101722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="Telemetry Live" FontSize="11" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="#475569" Margin="0,0,10,0"/>
                            <TextBlock Text="API:" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ApiEndpointUrl}" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ambient / Thermal Pill at Top Center -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#141B26" BorderBrush="#253347" BorderThickness="1" CornerRadius="12" Padding="12,5" Cursor="Help"
                        ToolTip="{Binding Summary.Chassis.Note}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌡️ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary.Chassis.DisplayText, FallbackValue='Estimating...'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock Text=" ℹ️" FontSize="10" Foreground="#64748B" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Send to Tray" Click="OnMinimizeToTrayClick" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="12,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="16,8">
            
            <!-- TAB 1: DASHBOARD & DRILLDOWNS -->
            <TabItem Header="Dashboard">
                <Grid>
                    <!-- 1A: MAIN DASHBOARD VIEW (Visible when no detail open) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DashboardVisibility}">
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CPU CARD (CLICKABLE) -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnCpuCardClick" ToolTip="Click to view all cores, throttling flags &amp; detailed telemetry">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PROCESSOR (CPU)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.Cpu.DisplayName, FallbackValue='CPU'}" TextTrimming="CharacterEllipsis" MaxWidth="280" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="#FF8A50" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Temp -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PACKAGE TEMP" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.TempC, StringFormat={}{0:F0}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#FF6B35"/>
                                                <TextBlock Text=" °C" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Load -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TOTAL LOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.LoadPercent, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Power -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PACKAGE POWER" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.PowerWatts, StringFormat={}{0:F1}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#FBBF24"/>
                                                <TextBlock Text=" W" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Summary.Cpu.LoadPercent, Mode=OneWay}" Maximum="100" Height="4" Background="#1E293B" Foreground="#FF6B35" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU CARD (CLICKABLE & MULTI-GPU SELECTOR) -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnGpuCardClick" ToolTip="Click to view detailed thermals, clocks &amp; fan speeds">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GRAPHICS (GPU)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        
                                        <!-- Multi-GPU Pill Switcher -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding GpuList}" Visibility="{Binding MultiGpuVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ShortName}" Tag="{Binding Id}" Click="OnGpuPillClick" Style="{StaticResource GpuPillButtonStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Single GPU Name fallback -->
                                            <TextBlock Text="{Binding CurrentGpu.Name}" TextTrimming="CharacterEllipsis" MaxWidth="240" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleGpus}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Details →" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Core Temp -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CORE TEMP" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.TempC, StringFormat={}{0:F0}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#38BDF8"/>
                                                <TextBlock Text=" °C" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGpu.HotspotDisplayText, FallbackValue='Hotspot: --'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Load -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CORE LOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.LoadPercent, StringFormat={}{0:F1}, TargetNullValue='0.0', FallbackValue='0.0'}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGpu.FanDisplayText, FallbackValue='Fan: N/A'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Power / VRAM -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CurrentGpu.PowerLabel, FallbackValue='BOARD POWER'}" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.PowerWatts, StringFormat={}{0:F1}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#FBBF24"/>
                                                <TextBlock Text=" W" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGpu.VramUsedGb, StringFormat={}VRAM: {0:F1} GB, TargetNullValue='VRAM: --', FallbackValue='VRAM: --'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentGpu.LoadPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="4" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- MEMORY CARD (CLICKABLE) -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnMemoryCardClick" ToolTip="Click to view detailed memory breakdown">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SYSTEM MEMORY (RAM)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Summary.Memory.SpeedMts, StringFormat={}{0} MT/s, TargetNullValue='', FallbackValue=''}" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="#A855F7" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="IN USE / TOTAL" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Memory.UsedGb, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text="{Binding Summary.Memory.TotalGb, StringFormat={} / {0:F0} GB}" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UTILIZATION" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Memory.Percent, StringFormat={}{0:F0}}" Style="{StaticResource MetricValueText}" Foreground="#A855F7"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Summary.Memory.Percent, Mode=OneWay}" Maximum="100" Height="4" Background="#1E293B" Foreground="#A855F7" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- NETWORK & POWER CARD (CLICKABLE) -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnNetworkCardClick" ToolTip="{Binding NetworkCardToolTip}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NetworkCardTitle}" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Summary.Network.DisplayDeviceName, FallbackValue='Network'}" ToolTip="{Binding Summary.Network.AdapterDescription}" TextTrimming="CharacterEllipsis" MaxWidth="280" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{Binding BatteryColumnWidth}"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DOWNLOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Network.DownloadMbps, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}" Foreground="#34D399"/>
                                                <TextBlock Text=" Mb/s" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UPLOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Network.UploadMbps, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}" Foreground="#6EE7B7"/>
                                                <TextBlock Text=" Mb/s" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Visibility="{Binding BatteryVisibility}">
                                            <TextBlock Text="BATTERY" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Battery.DisplayPercent, FallbackValue='--%'}" Style="{StaticResource MetricValueText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- STORAGE VOLUMES (CLICKABLE) -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnStorageCardClick" ToolTip="Click to view full SMART drive diagnostics">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="STORAGE VOLUMES &amp; DRIVES" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Details →" Foreground="#FF8A50" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Summary.Storage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Live Speeds & Temp -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='', FallbackValue=''}" ToolTip="{Binding TempTooltip}" Cursor="Help" Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                        <TextBlock Text="R: " FontSize="10" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ReadSpeedMBps, StringFormat={}{0:F0}}" FontSize="11" Foreground="#34D399" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" W: " FontSize="10" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding WriteSpeedMBps, StringFormat={}{0:F0}}" FontSize="11" Foreground="#F59E0B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" MB/s" FontSize="10" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <Grid Grid.Column="2" Margin="10,0,20,0" VerticalAlignment="Center">
                                                        <ProgressBar Value="{Binding UsedGb, Mode=OneWay}" Minimum="0" Maximum="{Binding TotalGb, Mode=OneWay}" Height="6" Background="#1E293B" Foreground="#FF6B35" BorderThickness="0"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UsedGb, StringFormat={}{0:F0} GB}" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding TotalGb, StringFormat={} / {0:F0} GB}" Foreground="#64748B" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding UsedPercent, StringFormat={} ({0:F0}%)}" Foreground="#94A3B8" FontFamily="Consolas" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </ScrollViewer>

                    <!-- 1B: COMPONENT DRILLDOWN VIEW (Visible when a card is clicked) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetailVisibility}">
                        <StackPanel Margin="0,10">
                            
                            <!-- Breadcrumb & Back Bar -->
                            <Border Style="{StaticResource StaticCard}" Margin="8,0,8,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="← Back to Dashboard" Click="OnBackToDashboardClick" Background="#1E293B" Foreground="#FF8A50" FontWeight="Bold" BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="0,0,16,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Multi-GPU switcher in detail header -->
                                    <ItemsControl ItemsSource="{Binding GpuList}" Visibility="{Binding GpuDetailVisibility}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ShortName}" Tag="{Binding Id}" Click="OnGpuPillClick" Style="{StaticResource GpuPillButtonStyle}" Margin="4,0" Padding="10,5" FontSize="12"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- CPU DETAIL: PER-CORE BREAKDOWN (P-Cores and E-Cores) -->
                            <Border Style="{StaticResource StaticCard}" Visibility="{Binding CpuDetailVisibility}">
                                <StackPanel>
                                    <TextBlock Text="PER-CORE BREAKDOWN &amp; DIGITAL THERMAL SENSORS" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding Summary.Cpu.Cores}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141B26" BorderBrush="#222C3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6" Width="230">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                            <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='-- °C', FallbackValue='--'}" Foreground="#FF6B35" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Grid Margin="0,4,0,6">
                                                            <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:F0} MHz, TargetNullValue='-- MHz', FallbackValue=''}" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding LoadPercent, StringFormat={}{0:F0}%, TargetNullValue='0%', FallbackValue='0%'}" FontSize="12" Foreground="#38BDF8" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding LoadPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="4" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- STORAGE DETAIL: PHYSICAL DRIVES & SMART ATTRIBUTES -->
                            <Border Style="{StaticResource StaticCard}" Visibility="{Binding StorageDetailVisibility}">
                                <StackPanel>
                                    <TextBlock Text="PHYSICAL DRIVES &amp; USER-MODE SMART ATTRIBUTES" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding Summary.Storage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141B26" BorderBrush="#222C3D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Drive Name & Temp -->
                                                        <Grid Grid.Row="0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14"/>
                                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding BusType}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MediaType}" FontSize="10" Foreground="#34D399" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='-- °C'}" ToolTip="{Binding TempTooltip}" Cursor="Help" FontSize="16" FontWeight="Bold" Foreground="#FF6B35" FontFamily="Consolas" Margin="0,0,8,0"/>
                                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" ToolTip="{Binding TempTooltip}" Cursor="Help" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TempSource}" FontSize="10" Foreground="#94A3B8"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- SMART Attributes Grid -->
                                                        <Grid Grid.Row="1" Margin="0,12,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="FIRMWARE REVISION" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='N/A', FallbackValue='N/A'}" Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="SERIAL NUMBER" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding SerialNumber, TargetNullValue='N/A', FallbackValue='N/A'}" Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="TRIM STATUS" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding TrimStatus, TargetNullValue='Active'}" Foreground="#34D399" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3">
                                                                <TextBlock Text="DRIVE HEALTH" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding HealthStatus, TargetNullValue='Healthy (OK)'}" Foreground="#34D399" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Capacity Bar & Live Speeds -->
                                                        <Border Grid.Row="2" Background="#0C1017" CornerRadius="6" Padding="12,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="VOLUME ALLOCATION" Style="{StaticResource SubLabel}"/>
                                                                        <TextBlock HorizontalAlignment="Right" Foreground="#ECEFF4" FontFamily="Consolas" FontSize="11">
                                                                            <Run Text="{Binding UsedGb, Mode=OneWay, StringFormat={}{0:F1} GB}"/>
                                                                            <Run Text=" / " Foreground="#64748B"/>
                                                                            <Run Text="{Binding TotalGb, Mode=OneWay, StringFormat={}{0:F1} GB}" Foreground="#94A3B8"/>
                                                                            <Run Text=" (" Foreground="#64748B"/>
                                                                            <Run Text="{Binding UsedPercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                                                                            <Run Text=")" Foreground="#64748B"/>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <ProgressBar Value="{Binding UsedGb, Mode=OneWay}" Minimum="0" Maximum="{Binding TotalGb, Mode=OneWay}" Height="6" Background="#1E293B" Foreground="#FF6B35" BorderThickness="0"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="R: " FontSize="11" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ReadSpeedMBps, StringFormat={}{0:F1}}" FontSize="13" Foreground="#34D399" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" W: " FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding WriteSpeedMBps, StringFormat={}{0:F1}}" FontSize="13" Foreground="#F59E0B" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" MB/s" FontSize="11" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- DETAIL SENSORS TABLE -->
                            <Border Style="{StaticResource StaticCard}">
                                <StackPanel>
                                    <TextBlock Text="RAW TELEMETRY CHANNELS &amp; REGISTERS" Style="{StaticResource CardHeader}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding DetailMetrics}" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="#0F141C" RowBackground="#0F141C" AlternatingRowBackground="#151B26"
                                              BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                                              Foreground="#ECEFF4" HeadersVisibility="Column" MaxHeight="380">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#0C1017"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="220"/>
                                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="260"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Formatted}" Width="140" FontFamily="Consolas"/>
                                            <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat={}{0:F1}}" Width="90" FontFamily="Consolas"/>
                                            <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat={}{0:F1}}" Width="90" FontFamily="Consolas"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: RAW SENSORS -->
            <TabItem Header="All Sensors">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Complete hierarchical list of detected hardware sensors and channels:" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AllMetrics}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F141C" RowBackground="#0F141C" AlternatingRowBackground="#151B26"
                              BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                              Foreground="#ECEFF4" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0C1017"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#1E293B"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="200"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Formatted}" Width="120" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat={}{0:F1}}" Width="90" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat={}{0:F1}}" Width="90" FontFamily="Consolas"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10" MaxWidth="680" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TELEMETRY &amp; POLLING" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Polling Interval (ms)" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="How frequently inFaux queries native hardware probes." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tray Icon Sensor Badge" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Select which temperature metric is drawn on the tray icon." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding TraySensorTarget}" SelectedValuePath="Tag" Background="#1E293B" Foreground="#000000" VerticalAlignment="Center">
                                        <ComboBoxItem Content="CPU Package Temp" Tag="cpu_temp"/>
                                        <ComboBoxItem Content="Primary GPU Temp" Tag="gpu_temp"/>
                                        <ComboBoxItem Content="Highest (CPU or GPU)" Tag="auto_max_temp"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Active Network Adapter" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Select which network interface to monitor on the dashboard." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding PreferredNetworkAdapter}" SelectedValuePath="Tag" Background="#1E293B" Foreground="#000000" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Highest Traffic)" Tag="Auto"/>
                                        <ComboBoxItem Content="Wi-Fi (Intel AX210 / Wireless)" Tag="Wi-Fi 3"/>
                                        <ComboBoxItem Content="vEthernet (Hyper-V Switch)" Tag="vEthernet (Default Switch)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chassis Enclosure Form Factor" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding ChassisProfileSubLabel, FallbackValue='Calibrates the zero-driver thermodynamic air cavity solver.'}" Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding ChassisProfile}" SelectedValuePath="Tag" IsEnabled="{Binding IsPhysicalMachine}" ToolTip="{Binding ChassisProfileTooltip}" Background="#1E293B" Foreground="#000000" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Hardware Detected)" Tag="Auto"/>
                                        <ComboBoxItem Content="Laptop (Mobile Enclosure)" Tag="Laptop"/>
                                        <ComboBoxItem Content="Desktop (Tower Enclosure)" Tag="Desktop"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CPU THERMAL &amp; COOLER TUNING" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cooler Profile" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Scales thermal dissipation rate and cold plate resistance." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding CoolerProfile}" SelectedValuePath="Tag" Background="#1E293B" Foreground="#000000" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Balanced Desktop)" Tag="Auto"/>
                                        <ComboBoxItem Content="Liquid AIO (240mm - 360mm+)" Tag="AIO"/>
                                        <ComboBoxItem Content="Tower Air (Dual / Single Tower)" Tag="TowerAir"/>
                                        <ComboBoxItem Content="Compact / Stock / Laptop" Tag="Compact"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Thermal Calibration Offset" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Fine-tune modeled die temperatures against physical hardware." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-15" Maximum="15" Value="{Binding CpuThermalOffset}" SmallChange="0.5" LargeChange="1.0" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuThermalOffsetDisplay}" Foreground="#38BDF8" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU Power / TDP Target (Watts)" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Custom package power target for Joule heating (0 = Auto)." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding CpuTdpOverrideWatts, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="OPEN API INTEGRATION" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="API Server Port" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Localhost port for REST endpoints and WebSockets." Style="{StaticResource SubLabel}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ApiPort, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"/>
                                </Grid>

                                <Button Content="Test API in Browser (GET /api/v1/summary)" Click="OnOpenApiInBrowserClick" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="12,8" HorizontalAlignment="Left" Cursor="Hand" Margin="0,4,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SYSTEM &amp; LIFECYCLE" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>
                                <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows on user logon (Zero UAC prompts)" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Check for Updates" Click="OnCheckForUpdatesClick" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="Verify Cryptographic Hash" Click="OnVerifyHashClick" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="14,8" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#0C1017" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock Text="FoxDen Software • inFaux Hardware Telemetry Suite" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="100% User-Mode Telemetry • Zero Ring-0 Drivers" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Local Telemetry • Zero Bloat" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

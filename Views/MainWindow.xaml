<Window x:Class="InFox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="inFaux - Hardware Monitor"
        Height="760" Width="1120"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Modern Card Style with Dynamic Themed Hover Feedback -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StaticCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Monospace Value Text -->
        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, monospace"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Category Title Text -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentHoverBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Global ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-GPU Switcher Pill Button -->
        <Style x:Key="GpuPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentHoverBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Pill Toggle Switch (Inspired by WireFox) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryAccentHoverBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ToggleThumbBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style (Inspired by WireFox) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style (Inspired by WireFox uninstaller button) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryAccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dynamic TextBox Style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z" 
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dynamic ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Popup x:Name="Popup" 
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{DynamicResource CardBackgroundBrush}" 
                                            BorderBrush="{DynamicResource ControlBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,4,0,0" 
                                            Padding="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="Transparent" 
                                            CornerRadius="4" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Admin Notice Banner -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ADMIN NOTICE BANNER (Only visible if launched as Administrator) -->
        <Border Grid.Row="1" Visibility="{Binding AdminNoticeVisibility}" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="0,0,0,1" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="This app doesn't need admin! inFaux is 100% zero-driver and designed to run safely with standard user privileges." Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Click="OnDismissAdminNoticeClick" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Padding="6,2" FontSize="12" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <!-- App Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand + Live Telemetry / API on the Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/inFaux_IHS.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="in" FontSize="20" FontWeight="Light" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Faux" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionString}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                    </Border>

                    <!-- Telemetry Live & API Pill -->
                    <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="Telemetry Live" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="API:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ApiEndpointUrl}" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ambient / Thermal Pill at Top Center -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" Cursor="Help"
                        ToolTip="{Binding Summary.Chassis.Note}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌡️ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary.Chassis.DisplayText, FallbackValue='Estimating...'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" ℹ️" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Send to Tray" Click="OnMinimizeToTrayClick" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="16,8">
            
            <!-- TAB 1: DASHBOARD & DRILLDOWNS -->
            <TabItem Header="Dashboard">
                <Grid>
                    <!-- 1A: MAIN DASHBOARD VIEW (Visible when no detail open) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DashboardVisibility}">
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CPU CARD (CLICKABLE) -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnCpuCardClick" ToolTip="Click to view all cores, throttling flags &amp; detailed telemetry">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PROCESSOR (CPU)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.Cpu.DisplayName, FallbackValue='CPU'}" TextTrimming="CharacterEllipsis" MaxWidth="280" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Temp -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PACKAGE TEMP" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.TempC, StringFormat={}{0:F0}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                <TextBlock Text=" °C" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary.Cpu.VrmTempC, StringFormat={}VRM: {0:F0}°C, TargetNullValue='VRM: --', FallbackValue='VRM: --'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Load -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TOTAL LOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.LoadPercent, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary.Cpu.CoreCount, StringFormat={}{0} Logical Cores, FallbackValue='-- Cores'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Power -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PACKAGE POWER" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Cpu.PowerWatts, StringFormat={}{0:F1}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#FBBF24"/>
                                                <TextBlock Text=" W" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Summary.Cpu.ClockGhz, StringFormat={}{0:F2} GHz, TargetNullValue='-- GHz', FallbackValue='-- GHz'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Viewbox Width="12" Height="12" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Active CPU Turbo / Precision Boost">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary.Cpu.IsBoost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Canvas Width="16" Height="16">
                                                        <!-- Top Outlet Flange -->
                                                        <Line X1="14.8" Y1="1.2" X2="14.8" Y2="5.5" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <!-- Snail Body -->
                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M 14.8,2 L 7.5,2 C 3.8,2 1.5,4.8 1.5,8.8 C 1.5,12.8 4.2,15 8.2,15 C 12.2,15 14.8,12.5 14.8,9 L 14.8,5 L 10.5,5 C 9.2,5 8.2,6 8.2,7.5"/>
                                                        <!-- Wheel Bore Rim -->
                                                        <Ellipse Canvas.Left="4.8" Canvas.Top="5.8" Width="6.4" Height="6.4" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.0"/>
                                                        <!-- Center Turbine Hub -->
                                                        <Ellipse Canvas.Left="7.0" Canvas.Top="8.0" Width="2.0" Height="2.0" Fill="{DynamicResource PrimaryAccentBrush}"/>
                                                        <!-- Swirl Vanes (6-Blade) -->
                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M 8,8 C 7.5,7 7.8,6.2 8,5.8 M 8.9,8.5 C 9.8,8.2 10.4,8.7 10.8,9 M 8.9,9.5 C 9.4,10.3 9,11 8.7,11.4 M 8,10 C 7.5,10.8 6.9,10.6 6.5,10.2 M 7.1,9.5 C 6.3,9.7 5.8,9.2 5.4,9 M 7.1,8.5 C 6.8,7.8 7.3,7 7.5,6.6"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Summary.Cpu.LoadPercent, Mode=OneWay}" Maximum="100" Height="4" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU CARD (CLICKABLE & MULTI-GPU SELECTOR) -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnGpuCardClick" ToolTip="Click to view detailed thermals, clocks &amp; fan speeds">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GRAPHICS (GPU)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        
                                        <!-- Multi-GPU Pill Switcher -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding GpuList}" Visibility="{Binding MultiGpuVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ShortName}" Tag="{Binding Id}" Click="OnGpuPillClick" Style="{StaticResource GpuPillButtonStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Single GPU Name fallback -->
                                            <TextBlock Text="{Binding CurrentGpu.Name}" TextTrimming="CharacterEllipsis" MaxWidth="240" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleGpus}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Details →" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Core Temp -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CORE TEMP" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.TempC, StringFormat={}{0:F0}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                <TextBlock Text=" °C" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGpu.HotspotDisplayText, FallbackValue='Hotspot: --'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Load & Clock -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CORE LOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.LoadPercent, StringFormat={}{0:F1}, TargetNullValue='0.0', FallbackValue='0.0'}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentGpu.SubLoadDisplayText, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <!-- Active GPU Boost Turbo Vector Indicator (Design 2: Snout with 6-blade swirl turbine) -->
                                                <Viewbox Width="12" Height="12" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Active GPU Boost / Dynamic Precision Frequency Scaling">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentGpu.IsBoost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Canvas Width="16" Height="16">
                                                        <!-- Top Outlet Flange -->
                                                        <Line X1="14.8" Y1="1.2" X2="14.8" Y2="5.5" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <!-- Snail Body -->
                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M 14.8,2 L 7.5,2 C 3.8,2 1.5,4.8 1.5,8.8 C 1.5,12.8 4.2,15 8.2,15 C 12.2,15 14.8,12.5 14.8,9 L 14.8,5 L 10.5,5 C 9.2,5 8.2,6 8.2,7.5"/>
                                                        <!-- Wheel Bore Rim -->
                                                        <Ellipse Canvas.Left="4.8" Canvas.Top="5.8" Width="6.4" Height="6.4" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.0"/>
                                                        <!-- Center Turbine Hub -->
                                                        <Ellipse Canvas.Left="7.0" Canvas.Top="8.0" Width="2.0" Height="2.0" Fill="{DynamicResource PrimaryAccentBrush}"/>
                                                        <!-- Swirl Vanes (6-Blade) -->
                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M 8,8 C 7.5,7 7.8,6.2 8,5.8 M 8.9,8.5 C 9.8,8.2 10.4,8.7 10.8,9 M 8.9,9.5 C 9.4,10.3 9,11 8.7,11.4 M 8,10 C 7.5,10.8 6.9,10.6 6.5,10.2 M 7.1,9.5 C 6.3,9.7 5.8,9.2 5.4,9 M 7.1,8.5 C 6.8,7.8 7.3,7 7.5,6.6"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Power / VRAM & Fan -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CurrentGpu.PowerLabel, FallbackValue='BOARD POWER'}" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentGpu.PowerWatts, StringFormat={}{0:F1}, TargetNullValue='--', FallbackValue='--'}" Style="{StaticResource MetricValueText}" Foreground="#FBBF24"/>
                                                <TextBlock Text=" W" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGpu.SubPowerDisplayText, FallbackValue='VRAM: --'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentGpu.LoadPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="4" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- MEMORY CARD (CLICKABLE) -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnMemoryCardClick" ToolTip="Click to view detailed memory breakdown">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SYSTEM MEMORY (RAM)" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Summary.Memory.SpeedMts, StringFormat={}{0} MT/s, TargetNullValue='', FallbackValue=''}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="IN USE / TOTAL" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Memory.UsedGb, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}"/>
                                                <TextBlock Text="{Binding Summary.Memory.TotalGb, StringFormat={} / {0:F0} GB}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UTILIZATION" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Memory.Percent, StringFormat={}{0:F0}}" Style="{StaticResource MetricValueText}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                <TextBlock Text=" %" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Summary.Memory.Percent, Mode=OneWay}" Maximum="100" Height="4" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- NETWORK & POWER CARD (CLICKABLE) -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnNetworkCardClick" ToolTip="{Binding NetworkCardToolTip}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NetworkCardTitle}" Style="{StaticResource CardHeader}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Summary.Network.DisplayDeviceName, FallbackValue='Network'}" ToolTip="{Binding Summary.Network.AdapterDescription}" TextTrimming="CharacterEllipsis" MaxWidth="280" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Details →" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{Binding BatteryColumnWidth}"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DOWNLOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Network.DownloadMbps, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}" Foreground="#34D399"/>
                                                <TextBlock Text=" Mb/s" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UPLOAD" Style="{StaticResource SubLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary.Network.UploadMbps, StringFormat={}{0:F1}}" Style="{StaticResource MetricValueText}" Foreground="#6EE7B7"/>
                                                <TextBlock Text=" Mb/s" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Visibility="{Binding BatteryVisibility}" ToolTip="{Binding Summary.Battery.FullStatusTooltip}" Cursor="Help">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="BATTERY" Style="{StaticResource SubLabel}"/>
                                                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Summary.Battery.ShortStatusText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Summary.Battery.StatusIcon}" FontSize="15" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" VerticalAlignment="Center" Margin="0,0,5,2"/>
                                                <TextBlock Text="{Binding Summary.Battery.DisplayPercent, FallbackValue='--%'}" Style="{StaticResource MetricValueText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- STORAGE VOLUMES (CLICKABLE) -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MetricCard}" Cursor="Hand" MouseDown="OnStorageCardClick" ToolTip="Click to view full drive diagnostics &amp; hardware attributes">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="STORAGE VOLUMES &amp; DRIVES" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Details →" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Summary.Storage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Live Speeds & Temp -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='', FallbackValue=''}" ToolTip="{Binding TempTooltip}" Cursor="Help" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                        <TextBlock Text="R: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ReadSpeedMBps, StringFormat={}{0:F0}}" FontSize="11" Foreground="#10B981" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" W: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding WriteSpeedMBps, StringFormat={}{0:F0}}" FontSize="11" Foreground="#F59E0B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" MB/s" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <Grid Grid.Column="2" Margin="10,0,20,0" VerticalAlignment="Center">
                                                        <ProgressBar Value="{Binding UsedGb, Mode=OneWay}" Minimum="0" Maximum="{Binding TotalGb, Mode=OneWay}" Height="6" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UsedGb, StringFormat={}{0:F0} GB}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding TotalGb, StringFormat={} / {0:F0} GB}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding UsedPercent, StringFormat={} ({0:F0}%)}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </ScrollViewer>

                    <!-- 1B: COMPONENT DRILLDOWN VIEW (Visible when a card is clicked) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetailVisibility}">
                        <StackPanel Margin="0,10">
                            
                            <!-- Breadcrumb & Back Bar -->
                            <Border Style="{StaticResource StaticCard}" Margin="8,0,8,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="← Back to Dashboard" Click="OnBackToDashboardClick" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryAccentHoverBrush}" FontWeight="Bold" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand" Margin="0,0,16,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Multi-GPU switcher in detail header -->
                                    <ItemsControl ItemsSource="{Binding GpuList}" Visibility="{Binding GpuDetailVisibility}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ShortName}" Tag="{Binding Id}" Click="OnGpuPillClick" Style="{StaticResource GpuPillButtonStyle}" Margin="4,0" Padding="10,5" FontSize="12"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- CPU DETAIL: PER-CORE BREAKDOWN (P-Cores and E-Cores) -->
                            <Border Style="{StaticResource StaticCard}" Visibility="{Binding CpuDetailVisibility}">
                                <StackPanel>
                                    <!-- PROCHOT / MOUNTING FAILURE WARNING BANNER -->
                                    <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding ThrottlingDivergenceVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="HARDWARE PROCHOT / MOUNTING FAILURE DETECTED" FontWeight="Bold" Foreground="#FCA5A5" FontSize="13"/>
                                                <TextBlock Text="Compute workload is high but processor clocks have cratered to base/sub-base frequencies. Check cooler mounting tension, thermal paste contact, or AIO pump status." Foreground="#F87171" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- TIM LIFECYCLE & PASTE DIAGNOSTICS CARD -->
                                    <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                                            ToolTip="Tracks thermal paste degradation and pump-out. (Note: $20 boutique paste still won't fix a 253W boost spike or uneven mounting pressure, but we can track it anyway!)">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="THERMAL INTERFACE MATERIAL (TIM) DIAGNOSTICS" Style="{StaticResource SubLabel}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Summary.Cpu.TimProfile}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Summary.Cpu.TimStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="ESTIMATED HEALTH" Style="{StaticResource SubLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Summary.Cpu.TimHealthPercent, StringFormat={}{0:F0}%, FallbackValue='100%'}" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="APPLICATION AGE" Style="{StaticResource SubLabel}" HorizontalAlignment="Right"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TimAgeDisplay}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <Button Content="Set Today" Click="OnMarkTimAppliedTodayClick" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="10" FontWeight="SemiBold" Padding="6,2" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- MOTHERBOARD & VRM POWER-STAGE CARD -->
                                    <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                                            ToolTip="Motherboard VRM power delivery telemetry (ACPI thermal zone or estimated power-stage model).">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="MOTHERBOARD &amp; POWER DELIVERY" Style="{StaticResource SubLabel}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Summary.Motherboard.Model}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Summary.Cpu.VrmSource}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="VRM / MOSFET TEMP" Style="{StaticResource SubLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Summary.Cpu.VrmTempC, StringFormat={}{0:F0}°C, TargetNullValue='-- °C', FallbackValue='-- °C'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="MANUFACTURER" Style="{StaticResource SubLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Summary.Motherboard.Manufacturer}" TextWrapping="NoWrap" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="PER-CORE BREAKDOWN &amp; DIGITAL THERMAL SENSORS" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding Summary.Cpu.Cores}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6" Width="230" ToolTip="{Binding Description}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3" VerticalAlignment="Center" ToolTip="{Binding Description}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Type}" Value="P">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#1E3A8A"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="Core">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#1E3A8A"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="HT">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#312E81"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="SMT">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#312E81"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="E">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#134E4A"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="C">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#701A75"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='-- °C', FallbackValue='--'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Grid Margin="0,4,0,6">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:F0} MHz, TargetNullValue='-- MHz', FallbackValue=''}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                                                <Viewbox Width="11" Height="11" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Core Hardware Boost Active">
                                                                    <Viewbox.Style>
                                                                        <Style TargetType="Viewbox">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBoost}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Viewbox.Style>
                                                                    <Canvas Width="16" Height="16">
                                                                        <!-- Top Outlet Flange -->
                                                                        <Line X1="14.8" Y1="1.2" X2="14.8" Y2="5.5" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                        <!-- Snail Body -->
                                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                              Data="M 14.8,2 L 7.5,2 C 3.8,2 1.5,4.8 1.5,8.8 C 1.5,12.8 4.2,15 8.2,15 C 12.2,15 14.8,12.5 14.8,9 L 14.8,5 L 10.5,5 C 9.2,5 8.2,6 8.2,7.5"/>
                                                                        <!-- Wheel Bore Rim -->
                                                                        <Ellipse Canvas.Left="4.8" Canvas.Top="5.8" Width="6.4" Height="6.4" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.0"/>
                                                                        <!-- Center Turbine Hub -->
                                                                        <Ellipse Canvas.Left="7.0" Canvas.Top="8.0" Width="2.0" Height="2.0" Fill="{DynamicResource PrimaryAccentBrush}"/>
                                                                        <!-- Swirl Vanes (6-Blade) -->
                                                                        <Path Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              Data="M 8,8 C 7.5,7 7.8,6.2 8,5.8 M 8.9,8.5 C 9.8,8.2 10.4,8.7 10.8,9 M 8.9,9.5 C 9.4,10.3 9,11 8.7,11.4 M 8,10 C 7.5,10.8 6.9,10.6 6.5,10.2 M 7.1,9.5 C 6.3,9.7 5.8,9.2 5.4,9 M 7.1,8.5 C 6.8,7.8 7.3,7 7.5,6.6"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LoadPercent, StringFormat={}{0:F0}%, TargetNullValue='0%', FallbackValue='0%'}" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding LoadPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="4" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- STORAGE DETAIL: PHYSICAL DRIVES & HARDWARE ATTRIBUTES -->
                            <Border Style="{StaticResource StaticCard}" Visibility="{Binding StorageDetailVisibility}">
                                <StackPanel>
                                    <TextBlock Text="PHYSICAL DRIVES &amp; HARDWARE ATTRIBUTES" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding Summary.Storage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Drive Name & Temp -->
                                                        <Grid Grid.Row="0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding BusType}" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MediaType}" FontSize="10" Foreground="#34D399" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TempC, StringFormat={}{0:F0}°C, TargetNullValue='-- °C'}" ToolTip="{Binding TempTooltip}" Cursor="Help" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" Margin="0,0,8,0"/>
                                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip="{Binding TempTooltip}" Cursor="Help" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TempSource}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Hardware Attributes Grid -->
                                                        <Grid Grid.Row="1" Margin="0,12,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="130"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto" MinWidth="140"/>
                                                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                                <TextBlock Text="FIRMWARE REVISION" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding FirmwareRevision, TargetNullValue='N/A', FallbackValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                                                <TextBlock Text="SERIAL NUMBER" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding SerialNumber, TargetNullValue='N/A', FallbackValue='N/A'}" ToolTip="{Binding SerialNumber}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                                                <TextBlock Text="TRIM STATUS" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding TrimStatus, TargetNullValue='Active'}" Foreground="#34D399" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3">
                                                                <TextBlock Text="DRIVE HEALTH" Style="{StaticResource SubLabel}"/>
                                                                <TextBlock Text="{Binding HealthStatus, TargetNullValue='Healthy (OK)'}" Foreground="#34D399" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Capacity Bar & Live Speeds -->
                                                        <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="12,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="VOLUME ALLOCATION" Style="{StaticResource SubLabel}"/>
                                                                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11">
                                                                            <Run Text="{Binding UsedGb, Mode=OneWay, StringFormat={}{0:F1} GB}"/>
                                                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}"/>
                                                                            <Run Text="{Binding TotalGb, Mode=OneWay, StringFormat={}{0:F1} GB}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            <Run Text=" (" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                            <Run Text="{Binding UsedPercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                                                                            <Run Text=")" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <ProgressBar Value="{Binding UsedGb, Mode=OneWay}" Minimum="0" Maximum="{Binding TotalGb, Mode=OneWay}" Height="6" Background="{DynamicResource ProgressBarTrackBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderThickness="0"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="R: " FontSize="11" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ReadSpeedMBps, StringFormat={}{0:F1}}" FontSize="13" Foreground="#34D399" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" W: " FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding WriteSpeedMBps, StringFormat={}{0:F1}}" FontSize="13" Foreground="#F59E0B" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" MB/s" FontSize="11" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- DETAIL SENSORS TABLE -->
                            <Border Style="{StaticResource StaticCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="ALL SENSOR CHANNELS" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                        <Button Content="↺ Reset Min/Max" Click="OnResetMinMaxClick" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding DetailMetrics}" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="{DynamicResource CardBackgroundBrush}" RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource ControlBackgroundBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}" HeadersVisibility="Column" MaxHeight="380">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="220"/>
                                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="260"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Formatted}" Width="130" FontFamily="Consolas"/>
                                            <DataGridTextColumn Header="Min" Binding="{Binding FormattedMin}" Width="100" FontFamily="Consolas"/>
                                            <DataGridTextColumn Header="Max" Binding="{Binding FormattedMax}" Width="100" FontFamily="Consolas"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: RAW SENSORS -->
            <TabItem Header="All Sensors">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Complete hierarchical list of detected hardware sensors and channels:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="↺ Reset Min/Max" Click="OnResetMinMaxClick" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AllMetrics}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource CardBackgroundBrush}" RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="200"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Formatted}" Width="120" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding FormattedMin}" Width="100" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding FormattedMax}" Width="100" FontFamily="Consolas"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,10,24,60" MaxWidth="920" HorizontalAlignment="Center">

                        <!-- Page Title Header (Inspired by WireFox) -->
                        <StackPanel Margin="0,4,0,20">
                            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Configure hardware polling, tray telemetry, and application preferences." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Feature Callout: Zero-Driver Telemetry & Embedded REST API (Inspired by WireFox Setup Card) -->
                        <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with shield squircle badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Zero-Driver Telemetry &amp; Embedded REST API" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="inFaux operates 100% in user mode with standard privileges (0 UAC prompts). Zero Ring-0 kernel drivers, zero kernel attack surface. Live hardware telemetry is continuously served over embedded Kestrel REST and WebSocket endpoints." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Action / status row -->
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Default REST Endpoint: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding ApiEndpointUrl, StringFormat={}{0}/api/v1/summary}" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" FontSize="12"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="✓ Open Live API in Browser" Click="OnOpenApiInBrowserClick" Style="{StaticResource ActionButton}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Ecosystem Integrations: Elgato Stream Deck Companion (Zero-Config LCM) -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with Stream Deck badge and live status pill -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <TextBlock Text="🎛️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Elgato Stream Deck Companion Plugin" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Deploy native inFaux companion gauges directly onto your physical Stream Deck keys. Live CPU and GPU wattage, thermal color grading, and load progress bars. 100% zero-driver, zero-config." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"/>
                                    </StackPanel>

                                    <!-- Status Badge Pill -->
                                    <Border Grid.Column="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StreamDeckStatusColor}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StreamDeckStatusBadge}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Action / path row -->
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Deploy Target: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="%APPDATA%\Elgato\StreamDeck\Plugins" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📁 Open Folder" Click="OnOpenStreamDeckFolderClick" Style="{StaticResource ActionButton}" Margin="0,0,8,0" ToolTip="Open the Elgato Stream Deck plugins folder in Windows Explorer"/>
                                        <Button Content="Uninstall" Click="OnUninstallStreamDeckPluginClick" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Visibility="{Binding StreamDeckUninstallVisibility}" ToolTip="Remove the inFaux plugin from Elgato Stream Deck"/>
                                        <Button Content="{Binding StreamDeckActionButtonText}" Click="OnInstallStreamDeckPluginClick" Style="{StaticResource ActionButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Theme Appearance: 4 Fox Coats -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Fox Coat Themes" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Active: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentTheme.Name}" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Select your visual personality. Accents, card highlights, and title bars update dynamically." Style="{StaticResource SubLabel}" Margin="0,0,0,14"/>

                                <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="OnThemeCardClick" Margin="4,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CardBorder" CornerRadius="8" Padding="12,12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                                                    <Ellipse Width="36" Height="36" Fill="{Binding AccentHex}"/>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,8"/>
                                                                <Border x:Name="IndicatorPill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" Background="{DynamicResource CardBorderBrush}">
                                                                    <TextBlock x:Name="IndicatorText" Text="Inactive" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                                <Setter TargetName="IndicatorPill" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                                <Setter TargetName="IndicatorText" Property="Text" Value="Active ✓"/>
                                                                <Setter TargetName="IndicatorText" Property="Foreground" Value="{DynamicResource PrimaryAccentForegroundBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Arctic Fox Coat Variant (Visible only when Arctic Fox is active) -->
                                <Border Margin="4,14,4,0" Visibility="{Binding ArcticVariantVisibility}"
                                        Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="❄️ Arctic Coat Variant" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ArcticCoatModeName}" FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Switch between Midnight Glacial (Dark) and Blizzard Snow (Light)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌙 Dark" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox IsChecked="{Binding ArcticFoxLightMode}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                            <TextBlock Text="☀️ Light" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Silver Fox Coat Variant (Visible only when Silver Fox is active) -->
                                <Border Margin="4,14,4,0" Visibility="{Binding SilverVariantVisibility}"
                                        Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Silver Coat Variant" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SilverCoatModeName}" FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Switch between Stealth Slate and True Black OLED Midnight." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Standard" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox IsChecked="{Binding SilverFoxOledMode}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                            <TextBlock Text="OLED" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Group 1: System & Lifecycle Configuration (Screenshot 1 Inspired + Minimize on Startup) -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="System &amp; Lifecycle Configuration" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="🛡️ Zero UAC Elevation" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <!-- Start with Windows -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Start with Windows on user logon (Zero UAC prompts)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Registers a native user-level scheduled task to launch inFaux on logon without admin elevation." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Minimize on Startup (THE MISSED FEATURE!) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Minimize on startup" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Start quietly in the system tray notification area without opening the dashboard window." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeOnStartup}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Physical Environment & Thermal Calibration -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Physical Environment &amp; Thermal Calibration" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="⚡ Thermal Engine" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <!-- Chassis Enclosure -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Calibrates thermal airflow baseline. Desktops model open internal air circulation, while laptops model compact enclosure heat dissipation.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Chassis Enclosure Form Factor" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding ChassisProfileSubLabel, FallbackValue='Calibrate internal case airflow and heat dissipation.'}" Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding ChassisProfile}" SelectedValuePath="Tag" IsEnabled="{Binding IsPhysicalMachine}" ToolTip="{Binding ChassisProfileTooltip}" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Auto (Hardware Detected)" Tag="Auto"/>
                                        <ComboBoxItem Content="Laptop (Mobile Enclosure)" Tag="Laptop"/>
                                        <ComboBoxItem Content="Desktop (Tower Enclosure)" Tag="Desktop"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- In-Case Chassis Air Thermometer (BTHome / BLE) -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Listen passively for a wireless thermometer placed inside your PC case cavity. Overrides simulated chassis heat buildup with physical in-case air temperature.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="In-Case Air Thermometer (BTHome / BLE)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BleChassisStatusBadge}" FontSize="10.5" Foreground="{Binding BleChassisStatusColor}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Capture real internal case air temperature from an in-case Bluetooth thermometer." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding BleChassisMainText, Mode=OneWay}" Foreground="{DynamicResource BleTextBrush}"/>
                                            <Run Text="{Binding BleChassisRssiText, Mode=OneWay}" Foreground="{Binding BleChassisRssiColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Enable Listener" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <CheckBox IsChecked="{Binding EnableBleChassis}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding BleChassisSelectorVisibility}">
                                            <ComboBox ItemsSource="{Binding BleChassisSensorChoices}"
                                                      SelectedValue="{Binding BleChassisSensorMac}"
                                                      SelectedValuePath="Mac"
                                                      Style="{StaticResource DarkComboBox}"
                                                      MaxDropDownHeight="220"
                                                      Loaded="OnComboBoxLoaded"
                                                      PreviewMouseLeftButtonDown="OnComboBoxPreviewMouseDown"
                                                      PreviewKeyDown="OnComboBoxPreviewKeyDown"
                                                      DropDownOpened="OnComboBoxDropDownOpened"
                                                      ToolTip="Select the wireless thermometer placed inside your PC case cavity.">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Room Ambient Calibration Tool -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Calibrates ambient room temperature baseline. Match this to your room thermometer so your idle temperature is accurate.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Room Ambient Calibration" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Summary.Chassis.EstimatedAmbientDisplay, FallbackValue='71.6 °F (22.0 °C)'}" FontSize="10.5" Foreground="#34D399" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Calibrate estimated room ambient against your physical room temperature." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-10" Maximum="10" Value="{Binding RoomAmbientOffsetC}" SmallChange="0.5" LargeChange="1.0" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RoomAmbientOffsetDisplay}" Foreground="#34D399" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Wireless Room Thermometer (BTHome / BLE) -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Listen passively for nearby open-standard BTHome and BLE wireless thermometers (Shelly BLU, Xiaomi, ATC/PVVX, ESPHome). Replaces thermal estimation with live physical room temperature.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Wireless Room Thermometer (BTHome / BLE)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BleAmbientStatusBadge}" FontSize="10.5" Foreground="{Binding BleAmbientStatusColor}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Passively capture real room temperature from local Bluetooth beacons." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding BleAmbientMainText, Mode=OneWay}" Foreground="{DynamicResource BleTextBrush}"/>
                                            <Run Text="{Binding BleAmbientRssiText, Mode=OneWay}" Foreground="{Binding BleAmbientRssiColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Enable Listener" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <CheckBox IsChecked="{Binding EnableBleAmbient}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding BleSensorSelectorVisibility}">
                                            <ComboBox ItemsSource="{Binding BleSensorChoices}"
                                                      SelectedValue="{Binding BleAmbientSensorMac}"
                                                      SelectedValuePath="Mac"
                                                      Style="{StaticResource DarkComboBox}"
                                                      MaxDropDownHeight="220"
                                                      Loaded="OnComboBoxLoaded"
                                                      PreviewMouseLeftButtonDown="OnComboBoxPreviewMouseDown"
                                                      PreviewKeyDown="OnComboBoxPreviewKeyDown"
                                                      DropDownOpened="OnComboBoxDropDownOpened"
                                                      ToolTip="Select a discovered beacon by its physical MAC address, or keep Auto.">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Cooler Profile -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Selects cooling type and heat capacity (Liquid AIOs absorb initial heat bursts, while Air Coolers react faster to transient load changes).">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Cooler Hardware Profile" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Cooler type and thermal capacity (Liquid AIO, Tower Air, Stock)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding CoolerProfile}" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Auto (Balanced Desktop)" Tag="Auto"/>
                                        <ComboBoxItem Content="Liquid AIO (240mm - 360mm+)" Tag="AIO"/>
                                        <ComboBoxItem Content="Tower Air (Dual / Single Tower)" Tag="TowerAir"/>
                                        <ComboBoxItem Content="Compact / Stock / Laptop" Tag="Compact"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Post-Radiator / Cooler Exhaust Thermometer (BTHome / BLE) -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Listen passively for a wireless thermometer placed at radiator or cooler exhaust airflow. Measures live radiator ΔT cooling efficiency.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="290"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Post-Radiator Exhaust (BTHome / BLE)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BleRadiatorStatusBadge}" FontSize="10.5" Foreground="{Binding BleRadiatorStatusColor}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Measure exhaust air temperature and compute real-time radiator thermal delta (ΔT)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding BleRadiatorStatusText}" FontSize="11" Foreground="{Binding BleRadiatorStatusColor}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Enable Listener" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <CheckBox IsChecked="{Binding EnableBleRadiator}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding BleRadiatorSelectorVisibility}">
                                            <ComboBox ItemsSource="{Binding BleRadiatorSensorChoices}"
                                                      SelectedValue="{Binding BleRadiatorSensorMac}"
                                                      SelectedValuePath="Mac"
                                                      Style="{StaticResource DarkComboBox}"
                                                      MaxDropDownHeight="220"
                                                      Loaded="OnComboBoxLoaded"
                                                      PreviewMouseLeftButtonDown="OnComboBoxPreviewMouseDown"
                                                      PreviewKeyDown="OnComboBoxPreviewKeyDown"
                                                      DropDownOpened="OnComboBoxDropDownOpened"
                                                      ToolTip="Select the wireless thermometer placed at your radiator exhaust.">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Step 4: Thermal Interface Material (TIM) Profile Selection -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Compound lifecycle model. (Warning: Premium $20 boutique thermal paste is not a substitute for proper AIO mounting torque or removing the plastic peel!)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Thermal Interface Material (TIM)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Thermal paste conductivity and estimated service life." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedTimProfile}" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="320"
                                              ToolTip="Compound lifecycle model. (Warning: Premium thermal paste is not a substitute for proper AIO mounting torque!)">
                                        <ComboBoxItem Content="Standard OEM / Stock Paste" Tag="Auto"/>
                                        <ComboBoxItem Content="Arctic MX-6" Tag="Arctic_MX6"/>
                                        <ComboBoxItem Content="Arctic MX-4" Tag="Arctic_MX4"/>
                                        <ComboBoxItem Content="Noctua NT-H2" Tag="Noctua_NTH2"/>
                                        <ComboBoxItem Content="Noctua NT-H1" Tag="Noctua_NTH1"/>
                                        <ComboBoxItem Content="Thermal Grizzly Kryonaut" Tag="Kryonaut"/>
                                        <ComboBoxItem Content="Thermal Grizzly Kryonaut Extreme" Tag="Kryonaut_Extreme"/>
                                        <ComboBoxItem Content="Thermal Grizzly Hydronaut / Aeronaut" Tag="Hydronaut"/>
                                        <ComboBoxItem Content="Thermalright TF Series (TF7/TF8/TF9)" Tag="Thermalright_TF"/>
                                        <ComboBoxItem Content="Kingpin Cooling KPx" Tag="Kingpin_KPx"/>
                                        <ComboBoxItem Content="Gelid GC-Extreme" Tag="Gelid_GC"/>
                                        <ComboBoxItem Content="Corsair TM30 / XTM50 / XTM70" Tag="Corsair_TM"/>
                                        <ComboBoxItem Content="Prolimatech PK-3" Tag="Prolimatech_PK3"/>
                                        <ComboBoxItem Content="Honeywell PTM7950 (Phase Change)" Tag="PTM7950"/>
                                        <ComboBoxItem Content="Thermal Grizzly PhaseSheet PTM" Tag="PhaseSheet_PTM"/>
                                        <ComboBoxItem Content="Liquid Metal (Conductonaut)" Tag="LiquidMetal"/>
                                        <ComboBoxItem Content="Coollaboratory Liquid Ultra / Pro" Tag="Coollaboratory_Liquid"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- TIM Application Date -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Tracks paste service life, silicone oil bleed, and pump-out dryout over time. Click [Today] to reset when you repaste.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Paste Application Date" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Set date when cooler was installed/repasted to track service life (YYYY-MM-DD)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding TimAppliedDateString, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" Content="Today" Click="OnMarkTimAppliedTodayClick" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,5" Margin="0,0,4,0" Cursor="Hand" VerticalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Grid.Column="2" Content="Clear" Click="OnClearTimAppliedDateClick" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" FontSize="11" Padding="8,5" Cursor="Hand" VerticalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- CPU Power / TDP Target -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Custom CPU package power limit in watts. Leave at 0 to automatically detect from CPU model.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="CPU Power / TDP Target (Watts)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Package power limit (0 = Auto-detect from CPU model)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding CpuTdpOverrideWatts, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Thermal Calibration Offset (Fine-Tuning) -->
                                <Grid Margin="0,4" Background="Transparent" ToolTip="Fine-tuning adjustment slider. Apply after setting chassis, ambient, and cooler options.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Thermal Calibration Offset (Fine-Tuning)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Apply a fine-tuning offset if needed to match your specific hardware." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-15" Maximum="15" Value="{Binding CpuThermalOffset}" SmallChange="0.5" LargeChange="1.0" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuThermalOffsetDisplay}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Hardware Polling & Telemetry Server -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Hardware Polling &amp; Telemetry Server" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="⏱ Live Probes &amp; API" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <!-- Polling Interval -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Polling Interval (ms)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="How frequently inFaux queries native hardware probes." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Tray Icon Sensor Target -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Tray Icon Sensor Badge" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Select which temperature metric is drawn on the tray icon." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding TraySensorTarget}" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}"
                                              Loaded="OnComboBoxLoaded"
                                              PreviewMouseLeftButtonDown="OnComboBoxPreviewMouseDown"
                                              PreviewKeyDown="OnComboBoxPreviewKeyDown"
                                              DropDownOpened="OnComboBoxDropDownOpened">
                                        <ComboBoxItem Content="CPU Package Temp" Tag="cpu_temp"/>
                                        <ComboBoxItem Content="Primary GPU Temp" Tag="gpu_temp"/>
                                        <ComboBoxItem Content="Highest (CPU or GPU)" Tag="auto_max_temp"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- Active Network Adapter -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Active Network Adapter" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Select which network interface to monitor on the dashboard." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding NetworkAdapterChoices}"
                                              SelectedValue="{Binding PreferredNetworkAdapter}" 
                                              SelectedValuePath="Id" 
                                              Style="{StaticResource DarkComboBox}"
                                              MaxDropDownHeight="220"
                                              Loaded="OnComboBoxLoaded"
                                              PreviewMouseLeftButtonDown="OnComboBoxPreviewMouseDown"
                                              PreviewKeyDown="OnComboBoxPreviewKeyDown"
                                              DropDownOpened="OnComboBoxDropDownOpened">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                                <!-- API Server Port -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="API Server Port" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Localhost port for REST endpoints and WebSockets (default: 8765)." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ApiPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 4: Cryptographic Integrity & Updates (Directly inspired by Screenshot 3) -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Cryptographic Integrity &amp; Updates" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="🔒 SHA-256 Verified" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,22">
                            <StackPanel>
                                <!-- Update & Audit Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <Button Content="Check for Updates" Click="OnCheckForUpdatesClick" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                                    <Button Content="External Hash Audit" Click="OnVerifyHashClick" Style="{StaticResource ActionButton}"/>
                                </StackPanel>

                                <!-- Local SHA-256 Box (Screenshot 3 inspired) -->
                                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Local SHA-256: " Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LocalExecutableHash}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Copy Hash" Click="OnCopyHashClick" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11.5"/>
                                    </Grid>
                                </Border>

                                <!-- Live status -->
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,12"/>

                                <!-- Automatic Update Checks Toggle -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Automatic Update Checks" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Silently check GitHub Releases once daily and notify when an official update is available." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding CheckForUpdates}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 5: About FoxDen Software (Directly inspired by Screenshot 3) -->
                        <TextBlock Text="About • FoxDen Software" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <Border Style="{StaticResource StaticCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- App Header Row -->
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Squircle Icon Container -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <Image Source="/inFaux_IHS.png" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="inFaux" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="by FoxDen Software" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}" Cursor="Hand" MouseDown="OnWebsiteClick" ToolTip="Visit GitHub Repository" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionString}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                            </Border>
                                            <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="License: PolyForm Noncommercial" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Copyright © 2026 FoxDen Software • Real telemetry. Faux drivers." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Descriptive Text -->
                                <TextBlock Text="Developed and maintained by FoxDen Software. Source-available under PolyForm Noncommercial License 1.0.0 — free to inspect, fork, and use; commercial competition and repackaging prohibited." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"/>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,14"/>

                                <!-- Clean System Removal Row (Screenshot 3 inspired) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Clean System Removal" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Cleanly deletes scheduled boot tasks, Start Menu shortcuts, and Program Files directory." Style="{StaticResource SubLabel}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Uninstall inFaux" Click="OnUninstallClick" Style="{StaticResource DangerButton}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock Text="FoxDen Software • inFaux Hardware Telemetry Suite" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="100% User-Mode Telemetry • Zero Ring-0 Drivers" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Local Telemetry • Zero Bloat" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- In-App Modern Themed Modal Dialog Overlay -->
        <Grid x:Name="InAppModalOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000" Visibility="Collapsed">
            <!-- Semi-transparent backdrop with click-to-dismiss support -->
            <Border Background="#99000000" MouseDown="OnModalBackdropMouseDown"/>
            
            <!-- Centered Modern Dialog Card -->
            <Border MaxWidth="520" MinWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource PrimaryAccentBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header with Icon & Title & Close (X) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Themed Icon Container -->
                        <Border x:Name="ModalIconContainer" Grid.Column="0" Width="38" Height="38" CornerRadius="8" 
                                Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" 
                                BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalIconText" Text="ℹ️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Title & Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalTitleText" Text="Dialog Title" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ModalSubtitleText" Text="Dialog Subtitle" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        
                        <!-- Top-Right Close Button -->
                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" Style="{StaticResource GhostButton}" 
                                Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Padding="0" Click="OnModalCloseClick" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,14"/>

                    <!-- Message Body -->
                    <TextBlock x:Name="ModalMessageText" Text="Dialog message body..." FontSize="12.5" LineHeight="18" 
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Optional Monospaced Details / Hash Card -->
                    <Border x:Name="ModalDetailsCard" Visibility="Collapsed" Background="{DynamicResource ControlBackgroundBrush}" 
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="ModalDetailsHeader" Text="Details" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                <Button x:Name="ModalCopyButton" Content="Copy" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5" Click="OnModalCopyClick"/>
                            </Grid>
                            <TextBox x:Name="ModalDetailsBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                     Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas, JetBrains Mono, monospace" 
                                     FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="140"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="ModalSecondaryButton" Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="90" Margin="0,0,10,0" Click="OnModalSecondaryClick" Visibility="Collapsed"/>
                        <Button x:Name="ModalPrimaryButton" Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="100" Click="OnModalPrimaryClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
